# === Obsidian Sync ===
OBSIDIAN_AUTH_TOKEN=<token-from-ob-login>

# === Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=whisper-1
# Chat/vision use the v1 API (endpoint + /openai/v1) and ignore this. It applies
# only to audio transcription, which the v1 route can't serve for Whisper.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# === Telegram ===
TELEGRAM_BOT_TOKEN=<token-from-botfather>
TELEGRAM_AUTHORIZED_USERS=your_username

# === Agent ===
LOG_LEVEL=INFO
LLM_MAX_TOKENS=4096
USER_TIMEZONE=Europe/Rome
# Persistent conversation memory (SQLite). Kept off the synced vault on purpose.
CHECKPOINTER_DB_PATH=/data/checkpoints.sqlite
# Conversation scope: a new session starts after this idle gap or on a date change.
# MAX_TOKENS is the backstop the trim middleware enforces before every model call.
CONVERSATION_IDLE_MINUTES=30
CONVERSATION_MAX_TOKENS=60000

# === Capture enrichment (master switch: tags + people/projects/tasks) ===
# Off disables the single Azure enrichment call entirely, so ENTITY_LINKING and
# TASK_EXTRACTION below have nothing to consume regardless of their own flags.
ENRICHMENT_ENABLED=true
TAXONOMY_SCAN_LIMIT=60
TAXONOMY_CACHE_TTL_SECONDS=1800
ENRICHMENT_MIN_CHARS=12

# === Entity linking (people/projects → hub notes; topics fold into tags) ===
ENTITY_LINKING_ENABLED=true
ENTITIES_FOLDER=Entities
ENTITY_CACHE_TTL_SECONDS=1800

# === Task extraction (daily ## ✅ Tasks section + central MOC) ===
TASK_EXTRACTION_ENABLED=true
TASKS_MOC_PATH=Tasks/Tasks.md

# === Smart vault search (structured retrieval tool) ===
# Max ranked hits returned per search; SCAN_LIMIT caps files walked per call.
SMART_SEARCH_MAX_RESULTS=5
SMART_SEARCH_SCAN_LIMIT=5000

# === URL Extraction ===
URL_EXTRACTION_ENABLED=true
URL_EXTRACTOR_BACKEND=crawl4ai
URL_EXTRACTION_MAX_URLS_PER_MESSAGE=3
URL_FETCH_TIMEOUT_SECONDS=25
URL_FETCH_MAX_CHARS=12000
URL_ALLOW_PRIVATE_NETS=false
URL_ALLOWED_DOMAINS=
URL_BLOCKED_DOMAINS=
LINK_NOTES_FOLDER=Links
ATTACHMENTS_FOLDER=Attachments
